# Sturmkrone MMO-Relay-Server – Vorlage für die Umgebung (als .env kopieren; .env nie einchecken)

# Port des Servers (WebSocket und GET /health)
PORT=8787

# Erlaubte Seiten, die sich verbinden dürfen (durch Komma getrennt), * = alle
# Beispiel: ALLOWED_ORIGINS=https://darnell-11.github.io
ALLOWED_ORIGINS=*

# Optional
# HOST=0.0.0.0
# MMO_SHARD=Bernsteinsee 1
# MMO_MAX_CLIENTS=300
# MMO_MAX_PER_IP=16
